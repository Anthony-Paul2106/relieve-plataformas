# Copy to .env.local for development. Set real values only in your local
# ignored .env.local or in the hosting provider's private environment settings.

# Set this to the public HTTPS URL assigned by the temporary hosting provider.
SITE_URL=https://your-site-name.netlify.app

# SMTP settings used only by the server-side contact route.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=

# Optional integrations. Leave blank if not configured.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
